#!/usr/bin/env bash
# ============================================================
#  FS Print · Workshop Claude Code — Bootstrap para Linux / WSL
#  Uso:  bash <(curl -fsSL https://datricas.github.io/kit/linux)
#
#  Arranque: instala lo mínimo, autentica contra GitHub y clona
#  el kit completo, que trae el instalador de verdad.
# ============================================================
set -euo pipefail

KIT_REPO="datricas/fsprint-claude-kit"
KIT_DIR="$HOME/.fsprint-kit"

azul() { printf '\033[1;34m%s\033[0m\n' "$*"; }
ok()   { printf '  \033[0;32m✓\033[0m %s\n' "$*"; }
info() { printf '  \033[0;36m→\033[0m %s\n' "$*"; }
err()  { printf '  \033[0;31m✗\033[0m %s\n' "$*" >&2; }
morir() { err "$1"; echo; echo "  Levantá la mano y lo vemos juntos."; exit 1; }

echo
azul "═══════════════════════════════════════════"
azul "  FS Print · Claude Code"
azul "  Preparando tu Linux"
azul "═══════════════════════════════════════════"
echo

# ---- 1. Paquetes base ----
info "Actualizando la lista de paquetes (puede pedir tu clave de Linux)..."
sudo apt-get update -qq || morir "No se pudo actualizar apt."
sudo apt-get install -y -qq curl git ca-certificates gnupg >/dev/null \
  || morir "No se pudieron instalar los paquetes base."
ok "curl y git"

# ---- 2. gh (GitHub CLI) ----
if ! command -v gh &>/dev/null; then
  info "Instalando gh..."
  sudo mkdir -p -m 755 /etc/apt/keyrings
  curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg >/dev/null
  sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | sudo tee /etc/apt/sources.list.d/github-cli.list >/dev/null
  sudo apt-get update -qq
  sudo apt-get install -y -qq gh >/dev/null || morir "No se pudo instalar gh."
fi
ok "gh"

# ---- 3. Autenticación con GitHub ----
if ! gh auth status &>/dev/null; then
  echo
  azul "  Iniciá sesión en GitHub"
  echo "  Copiá el código que aparece y pegalo en el navegador."
  echo
  gh auth login --hostname github.com --git-protocol https --web \
    || morir "No se pudo iniciar sesión en GitHub."
fi
# Sin esto, git pide usuario y contraseña — y GitHub sacó las contraseñas
# en 2021, asi que la contrasena no funciona y quedas trabado.
if ! gh auth setup-git 2>/dev/null; then
  err "No se pudo conectar git con GitHub."
  echo "  Proba a mano:  gh auth setup-git"
  exit 1
fi
# Confirmar que de verdad quedo: el helper tiene que estar en la config de git.
if ! git config --get-regexp 'credential.*helper' 2>/dev/null | grep -q gh; then
  aviso "git no quedo conectado con GitHub. Si te pide contrasena, corre: gh auth setup-git"
fi
ok "GitHub: $(gh api user --jq .login 2>/dev/null || echo 'sesión iniciada')"

# ---- 4. Clonar el kit ----
if [ -d "$KIT_DIR/.git" ]; then
  info "Actualizando el kit..."
  git -C "$KIT_DIR" pull --ff-only --quiet || true
else
  info "Bajando el kit de FS Print..."
  gh repo clone "$KIT_REPO" "$KIT_DIR" -- --quiet \
    || morir "No se pudo clonar $KIT_REPO. ¿Tu usuario de GitHub tiene acceso?"
fi
ok "Kit en $KIT_DIR"

echo
azul "  Arrancando la instalación completa..."
echo
exec bash "$KIT_DIR/bootstrap/linux.sh" "$@"
