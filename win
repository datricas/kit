# ============================================================
#  FS Print - Workshop Claude Code - Bootstrap para Windows
#
#  Uso (PowerShell COMO ADMINISTRADOR):
#      irm https://datricas.github.io/kit/win | iex
#
#  Para ver que haria sin tocar nada:
#      $env:FSPRINT_CHECK=1; irm https://datricas.github.io/kit/win | iex
#
#  UN comando y UN reinicio. Despues del reinicio el instalador se
#  reanuda SOLO: deja un RunOnce que espera a que Ubuntu este listo y
#  termina la instalacion sin que haya que escribir nada mas.
#
#  NOTA TECNICA: todo va adentro de una funcion y no hay ni un 'exit'.
#  Un script que llega por 'iex' corre en la sesion actual, asi que un
#  'exit' cerraria la ventana de PowerShell del usuario.
# ============================================================

function Invoke-FSPrintBootstrap {
  [CmdletBinding()]
  param([switch]$Check)

  # La variable se CONSUME: vale para una sola corrida y se borra.
  if ($env:FSPRINT_CHECK -eq '1') {
    $Check = $true
    Remove-Item Env:\FSPRINT_CHECK -ErrorAction SilentlyContinue
  }

  $eapPrevio = $ErrorActionPreference
  $ErrorActionPreference = 'Stop'

  function Azul($t)  { Write-Host $t -ForegroundColor Cyan }
  function OK($t)    { Write-Host "  [OK]  $t" -ForegroundColor Green }
  function Info($t)  { Write-Host "  ->    $t" -ForegroundColor Gray }
  function Aviso($t) { Write-Host "  [!]   $t" -ForegroundColor Yellow }
  function Error2($t){ Write-Host "  [X]   $t" -ForegroundColor Red }
  function Haria($t) {
    if ($Check) { Write-Host "  [~]   haria: $t" -ForegroundColor Yellow; return $true }
    return $false
  }

  # Deja armado el script que se ejecuta solo despues del reinicio.
  function Registrar-Continuacion {
    $ruta = Join-Path $env:LOCALAPPDATA 'fsprint-continuar.ps1'
    $cuerpo = @'
$Host.UI.RawUI.WindowTitle = "FS Print - terminando la instalacion"
function Azul($t) { Write-Host $t -ForegroundColor Cyan }
Write-Host ""
Azul "==========================================="
Azul "  FS Print - Terminando la instalacion"
Azul "==========================================="
Write-Host ""
Write-Host "  Esperando a que Ubuntu este listo..." -ForegroundColor Gray
Write-Host ""

$listo = $false
$aviso = $false
for ($i = 0; $i -lt 240; $i++) {
  try {
    $r = wsl.exe -d Ubuntu -- echo listo 2>$null
    if ($r -match 'listo') { $listo = $true; break }
  } catch { }

  if ($i -eq 3 -and -not $aviso) {
    $aviso = $true
    Write-Host "  Falta un paso tuyo, son 20 segundos:" -ForegroundColor Yellow
    Write-Host ""
    Write-Host "    Se tiene que haber abierto una ventana negra de Ubuntu." -ForegroundColor White
    Write-Host "    Te pide un usuario y una contrasena: pone los que quieras." -ForegroundColor White
    Write-Host "    La contrasena NO se ve mientras la escribis. Es normal." -ForegroundColor White
    Write-Host ""
    Write-Host "    Si no se abrio, buscala en el menu Inicio como 'Ubuntu'." -ForegroundColor Gray
    Write-Host ""
    Write-Host "  Esta ventana sigue sola en cuanto termines." -ForegroundColor Gray
    Write-Host ""
    try { Start-Process 'ubuntu.exe' -ErrorAction SilentlyContinue } catch { }
  }
  Start-Sleep -Seconds 5
}

if (-not $listo) {
  Write-Host "  [X]  Ubuntu no respondio." -ForegroundColor Red
  Write-Host "       Abri Ubuntu desde el menu Inicio, crea usuario y contrasena," -ForegroundColor Gray
  Write-Host "       y pega este comando adentro:" -ForegroundColor Gray
  Write-Host ""
  Write-Host "         bash <(curl -fsSL https://datricas.github.io/kit/linux)" -ForegroundColor White
  Write-Host ""
  Read-Host "  Enter para cerrar"
  return
}

Write-Host "  [OK] Ubuntu responde. Instalando el resto..." -ForegroundColor Green
Write-Host ""
wsl.exe -d Ubuntu -- bash -lc "curl -fsSL https://datricas.github.io/kit/linux | bash"

Write-Host ""
if ($LASTEXITCODE -eq 0) {
  Azul "==========================================="
  Write-Host "  LISTO. Ya podes cerrar esta ventana." -ForegroundColor Green
  Write-Host ""
  Write-Host "  Abri Windows Terminal y escribi:  doctor" -ForegroundColor White
  Azul "==========================================="
} else {
  Write-Host "  [X]  Algo fallo. Sacale una foto a esto y avisa." -ForegroundColor Red
}
Write-Host ""
Read-Host "  Enter para cerrar"
'@
    Set-Content -Path $ruta -Value $cuerpo -Encoding UTF8
    $cmd = "powershell -ExecutionPolicy Bypass -File `"$ruta`""
    New-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\RunOnce' `
      -Name 'FSPrintKit' -Value $cmd -PropertyType String -Force | Out-Null
  }

  try {
    Write-Host ""
    Azul "==========================================="
    if ($Check) { Azul "  MODO CHEQUEO - NO SE VA A INSTALAR NADA" }
    else        { Azul "  FS Print - Preparando tu Windows" }
    Azul "==========================================="
    Write-Host ""

    # ---- 1. Permisos de administrador ----
    $esAdmin = ([Security.Principal.WindowsPrincipal] `
      [Security.Principal.WindowsIdentity]::GetCurrent()
      ).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)

    if (-not $esAdmin) {
      Error2 "Abri PowerShell como administrador (boton derecho sobre el icono > Ejecutar como administrador) y volve a pegar el comando."
      return
    }
    OK "Permisos de administrador"

    # ---- 2. Version de Windows ----
    $build = [int](Get-CimInstance Win32_OperatingSystem).BuildNumber
    if ($build -lt 19041) {
      Error2 "Tu Windows es muy viejo para WSL2 (build $build, hace falta 19041 o mayor)."
      return
    }
    OK "Windows build $build"

    # ---- 3. Las dos funciones de Windows que WSL2 necesita ----
    $huboCambio = $false
    foreach ($f in @('Microsoft-Windows-Subsystem-Linux', 'VirtualMachinePlatform')) {
      try {
        $estado = (Get-WindowsOptionalFeature -Online -FeatureName $f).State
        if ($estado -ne 'Enabled') {
          if (-not (Haria "activar $f")) {
            Info "Activando $f..."
            Enable-WindowsOptionalFeature -Online -FeatureName $f -All -NoRestart | Out-Null
            $huboCambio = $true
          }
        } else {
          OK "$f"
        }
      } catch {
        Aviso "No pude revisar $f."
      }
    }

    # ---- 4. Ubuntu ----
    $ubuntuListo = $false
    try {
      $distros = (wsl.exe --list --quiet 2>$null) -replace "`0", ""
      if ($distros -match 'Ubuntu') { $ubuntuListo = $true }
    } catch { }

    if (-not $ubuntuListo) {
      if (-not (Haria "instalar Ubuntu")) {
        Info "Instalando Ubuntu. Tarda unos minutos..."
        wsl.exe --install -d Ubuntu --no-launch 2>$null
        if ($LASTEXITCODE -ne 0) {
          # Las versiones viejas de wsl.exe no conocen --no-launch
          wsl.exe --install -d Ubuntu
        }
        if ($LASTEXITCODE -ne 0 -and -not $huboCambio) {
          Write-Host ""
          Error2 "La instalacion de Ubuntu fallo (codigo $LASTEXITCODE)."
          Write-Host ""
          Write-Host "  Causas mas comunes, en orden:" -ForegroundColor Gray
          Write-Host "    1. Virtualizacion apagada en la BIOS (Intel VT-x / AMD-V)." -ForegroundColor Gray
          Write-Host "    2. Falta reiniciar. Reinicia y volve a pegar el comando." -ForegroundColor Gray
          Write-Host "    3. Windows sin actualizar. Proba: wsl --update" -ForegroundColor Gray
          Write-Host ""
          return
        }
        # Dejamos constancia de que Ubuntu la instalamos NOSOTROS. Si ya la
        # tenia de antes, no queremos que el desinstalador se la lleve puesta.
        try {
          New-Item -Path 'HKCU:\Software\Datricas' -Force | Out-Null
          New-ItemProperty -Path 'HKCU:\Software\Datricas' -Name 'UbuntuInstaladaPorElKit' `
            -Value 1 -PropertyType DWord -Force | Out-Null
        } catch { }

        $huboCambio = $true
      }
    } else {
      OK "Ubuntu ya estaba instalado"
      Info "No la vamos a tocar al desinstalar: ya era tuya."
    }

    # ---- 5. Windows Terminal y la fuente ----
    if (-not (Get-Command wt.exe -ErrorAction SilentlyContinue)) {
      if (-not (Haria "instalar Windows Terminal")) {
        Info "Instalando Windows Terminal..."
        try {
          winget install --id Microsoft.WindowsTerminal -e --silent `
            --accept-package-agreements --accept-source-agreements | Out-Null
          OK "Windows Terminal"
        } catch { Aviso "No se pudo instalar Windows Terminal." }
      }
    } else { OK "Windows Terminal" }

    if (-not (Haria "instalar la fuente Nerd Font")) {
      try {
        winget install --id DEVCOM.JetBrainsMonoNerdFont -e --silent `
          --accept-package-agreements --accept-source-agreements | Out-Null
        OK "Fuente Nerd Font"
      } catch { Aviso "La fuente hay que ponerla a mano. No frena nada." }
    }

    if ($Check) {
      Write-Host ""
      Azul "==========================================="
      Write-Host "  CHEQUEO TERMINADO - NO SE INSTALO NADA" -ForegroundColor Yellow
      Azul "==========================================="
      Write-Host ""
      Write-Host "  Para instalar de verdad:" -ForegroundColor Gray
      Write-Host "      irm https://datricas.github.io/kit/win | iex" -ForegroundColor White
      Write-Host ""
      return
    }

    # ---- 6. Si hubo que tocar Windows: reiniciar y reanudar solo ----
    if ($huboCambio) {
      Registrar-Continuacion
      Write-Host ""
      Azul "==========================================="
      Write-Host "  HAY QUE REINICIAR - UNA SOLA VEZ" -ForegroundColor Yellow
      Azul "==========================================="
      Write-Host ""
      Write-Host "  Cuando vuelvas a prender, la instalacion SIGUE SOLA." -ForegroundColor White
      Write-Host "  No tenes que escribir ningun comando mas." -ForegroundColor White
      Write-Host ""
      Write-Host "  Lo unico que te va a pedir es un usuario y una contrasena" -ForegroundColor Gray
      Write-Host "  para Ubuntu. Son 20 segundos." -ForegroundColor Gray
      Write-Host ""
      $rta = Read-Host "  Reiniciar ahora? [S/n]"
      if ($rta -eq '' -or $rta -match '^[sSyY]') {
        Write-Host ""
        Write-Host "  Reiniciando en 5 segundos..." -ForegroundColor Gray
        Start-Sleep -Seconds 5
        Restart-Computer -Force
      } else {
        Write-Host ""
        Write-Host "  Bueno. Reinicia cuando puedas y sigue solo." -ForegroundColor Gray
        Write-Host ""
      }
      return
    }

    # ---- 7. Nada que reiniciar: se termina de una ----
    Write-Host ""
    Azul "  Entrando a Linux para instalar el resto..."
    Write-Host ""
    wsl.exe -d Ubuntu -- bash -lc "curl -fsSL https://datricas.github.io/kit/linux | bash"
    if ($LASTEXITCODE -ne 0) {
      Error2 "El instalador de Linux fallo. Mira el error de arriba."
      return
    }

    Write-Host ""
    Azul "==========================================="
    OK "Listo."
    Write-Host ""
    Write-Host "  Abri Windows Terminal y escribi:  doctor" -ForegroundColor White
    Write-Host ""
    Azul "==========================================="
    Write-Host ""
  }
  catch {
    Write-Host ""
    Error2 "Error inesperado: $($_.Exception.Message)"
    Write-Host "  Sacale una foto a esto y avisa." -ForegroundColor Gray
    Write-Host ""
  }
  finally {
    $ErrorActionPreference = $eapPrevio
  }
}

Invoke-FSPrintBootstrap
