#!/usr/bin/env bash
# ============================================================
#  FS Print · Workshop Claude Code — DESINSTALADOR
#
#  Uso:
#     bash <(curl -fsSL https://datricas.github.io/kit/desinstalar)
#
#  Deja la máquina como estaba: restaura las configuraciones que se
#  habían guardado y borra todo lo que agregó el kit.
#
#  Por defecto NO toca herramientas de uso general (git, node, tmux,
#  Homebrew, Oh My Zsh) porque pueden estar en uso por otras cosas.
#  Para sacar también eso:
#     bash <(curl -fsSL https://datricas.github.io/kit/desinstalar) --todo
# ============================================================
set -uo pipefail

TODO=0
[ "${1:-}" = "--todo" ] && TODO=1

KIT_DIR="$HOME/.fsprint-kit"
PRACTICA_DIR="$HOME/practica/demo-app"

azul() { printf '\033[1;34m%s\033[0m\n' "$*"; }
ok()   { printf '  \033[0;32m✓\033[0m %s\n' "$*"; }
info() { printf '  \033[0;36m→\033[0m %s\n' "$*"; }
skip() { printf '  \033[0;90m·\033[0m %s\n' "$*"; }

# Devuelve el archivo a como estaba antes del kit.
restaurar() {
  local destino="$1" nombre; nombre="$(basename "$destino")"
  if [ -L "$destino" ]; then
    local apunta; apunta="$(readlink "$destino" 2>/dev/null || true)"
    case "$apunta" in
      *fsprint-kit*) rm -f "$destino"; ok "$nombre — enlace del kit borrado" ;;
      *) skip "$nombre — no era del kit, no lo toco"; return ;;
    esac
  elif [ -f "$destino" ]; then
    # Archivo propio: le sacamos solo el bloque que agregó el kit.
    if grep -q 'fsprint' "$destino" 2>/dev/null; then
      cp "$destino" "$destino.antes-de-desinstalar"
      python3 - "$destino" <<'PY'
import sys, re
p = sys.argv[1]
l = open(p, encoding='utf-8', errors='replace').read().split('\n')
fuera, saltar = [], False
for i, x in enumerate(l):
    if '--- FS Print kit ---' in x:
        saltar = True
        continue
    if saltar:
        # El bloque del kit son las lineas siguientes que lo mencionan
        if 'fsprint' in x or x.strip() == '':
            if 'fsprint' in x: continue
            saltar = False
        else:
            saltar = False
    if 'fsprint-kit' in x or 'FSPRINT_NO_ZSH' in x:
        continue
    fuera.append(x)
open(p, 'w', encoding='utf-8').write('\n'.join(fuera))
PY
      ok "$nombre — líneas del kit quitadas"
    else
      skip "$nombre — no tenía nada del kit"
      return
    fi
  else
    skip "$nombre — no existe"
    return
  fi

  # Si habíamos guardado el original, lo devolvemos.
  if [ -f "$destino.antes-del-kit" ] && [ ! -e "$destino" ]; then
    mv "$destino.antes-del-kit" "$destino"
    ok "$nombre — restaurado el tuyo"
  fi
}

echo
azul "═══════════════════════════════════════════"
azul "  FS Print · Desinstalar el kit"
azul "═══════════════════════════════════════════"
echo
echo "  Se va a borrar:"
echo "    · El kit           $KIT_DIR"
echo "    · La app de práctica  $HOME/practica"
echo "    · Los comandos     doctor, duo, reset-practica, tema"
echo "    · La configuración que agregó el kit (se restaura la tuya)"
echo "    · Los plugins y ajustes de Claude que puso el kit"
if [ "$TODO" = "1" ]; then
  echo
  printf '    \033[0;33m· MODO --todo: también Oh My Zsh, starship, zoxide, eza y Chrome de WSL\033[0m\n'
fi
echo
echo "  NO se toca: git, node, tmux, Homebrew, tu sesión de Claude ni la de GitHub."
echo
printf "  ¿Seguimos? [s/N] "
read -r rta
case "$rta" in s|S|si|SI|Si|y|Y) ;; *) echo "  Cancelado."; exit 0 ;; esac

# ── 1. Configuración ──
echo; azul "1/6 · Configuración"
restaurar "$HOME/.zshrc"
restaurar "$HOME/.bashrc"
restaurar "$HOME/.config/starship.toml"
restaurar "$HOME/.config/tmux/tmux.conf"
restaurar "$HOME/.config/ghostty/config"

if git config --global --get-all include.path 2>/dev/null | grep -q fsprint; then
  git config --global --unset-all include.path "$(git config --global --get-all include.path | grep fsprint | head -1)" 2>/dev/null
  ok "gitconfig — se quitó el include del kit (tu nombre y mail quedan)"
else
  skip "gitconfig — no tenía nada del kit"
fi

# ── 2. Comandos y archivos sueltos ──
echo; azul "2/6 · Comandos"
for c in doctor duo reset-practica tema; do
  if [ -e "$HOME/.local/bin/$c" ] || [ -L "$HOME/.local/bin/$c" ]; then
    rm -f "$HOME/.local/bin/$c"; ok "$c"
  else
    skip "$c — no estaba"
  fi
done
[ -f "$HOME/listo.mp3" ] && { rm -f "$HOME/listo.mp3"; ok "listo.mp3"; } || skip "listo.mp3 — no estaba"
[ -f "$HOME/.hushlogin" ] && { rm -f "$HOME/.hushlogin"; ok "vuelve el saludo de Ubuntu"; } || true

# ── 3. Ajustes de Claude ──
echo; azul "3/6 · Ajustes de Claude"
if [ -f "$HOME/.claude/settings.json" ]; then
  python3 - "$HOME/.claude/settings.json" <<'PY'
import json, sys
p = sys.argv[1]
try:
    d = json.load(open(p, encoding='utf-8'))
except Exception:
    sys.exit(0)

# El aviso sonoro que puso el kit
h = d.get('hooks', {})
if 'Stop' in h:
    h['Stop'] = [g for g in h['Stop']
                 if not any('listo.mp3' in str(x.get('command','')) for x in g.get('hooks', []))]
    if not h['Stop']: del h['Stop']
    if not h: d.pop('hooks', None)

# Equipos de agentes
env = d.get('env', {})
env.pop('CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS', None)
if not env: d.pop('env', None)
d.pop('teammateMode', None)

json.dump(d, open(p, 'w', encoding='utf-8'), indent=2, ensure_ascii=False)
PY
  ok "aviso sonoro y equipos de agentes"
else
  skip "no había settings.json"
fi

if [ -f "$HOME/.claude.json" ]; then
  python3 - "$HOME/.claude.json" "$PRACTICA_DIR" <<'PY'
import json, os, sys
p, practica = sys.argv[1], os.path.realpath(sys.argv[2])
try:
    d = json.load(open(p, encoding='utf-8'))
except Exception:
    sys.exit(0)
pr = d.get('projects', {})
for k in [k for k in pr if os.path.realpath(k) == practica]:
    del pr[k]
json.dump(d, open(p, 'w', encoding='utf-8'), indent=2, ensure_ascii=False)
PY
  ok "carpeta de práctica quitada de la lista de proyectos"
fi

if command -v claude &>/dev/null; then
  claude mcp remove chrome --scope user &>/dev/null && ok "conexión chrome" || skip "conexión chrome — no estaba"
  for pl in chrome-devtools-mcp context7 typescript-lsp; do
    claude plugin uninstall "$pl" &>/dev/null && ok "plugin $pl" || skip "plugin $pl — no estaba"
  done
fi

# ── 4. El kit y la app ──
echo; azul "4/6 · Archivos del kit"
[ -d "$KIT_DIR" ] && { rm -rf "$KIT_DIR"; ok "$KIT_DIR"; } || skip "el kit no estaba"
if [ -d "$HOME/practica" ]; then
  rm -rf "$HOME/practica"; ok "$HOME/practica"
else
  skip "la carpeta de práctica no estaba"
fi

# ── 5. Extras del modo --todo ──
echo; azul "5/6 · Herramientas"
if [ "$TODO" = "1" ]; then
  [ -d "$HOME/.oh-my-zsh" ] && { rm -rf "$HOME/.oh-my-zsh"; ok "Oh My Zsh"; }
  for b in starship zoxide eza; do
    rm -f "$HOME/.local/bin/$b" 2>/dev/null
    if command -v brew &>/dev/null; then brew uninstall --quiet "$b" &>/dev/null && ok "$b"; fi
  done
  if grep -qi microsoft /proc/version 2>/dev/null; then
    sudo apt-get remove -y -qq google-chrome-stable &>/dev/null && ok "Chrome de WSL"
  fi
  info "git, node y tmux se dejan: los usa el resto del sistema"
else
  skip "no se tocan (usá --todo si las querés sacar)"
fi

# ── 6. Cierre ──
echo; azul "6/6 · Listo"
echo
echo "  Quedaron sin tocar, a propósito:"
echo "    · Tu sesión de Claude Code   (para sacarla: claude logout)"
echo "    · Tu sesión de GitHub        (para sacarla: gh auth logout)"
echo "    · git, node, tmux y Homebrew"
if grep -qi microsoft /proc/version 2>/dev/null; then
  echo
  printf '  \033[1;33mEstás en Windows (WSL).\033[0m Para sacar Ubuntu y WSL por completo,\n'
  echo "  desde PowerShell como administrador:"
  echo
  echo "      irm https://datricas.github.io/kit/desinstalar-win | iex"
fi
echo
azul "═══════════════════════════════════════════"
ok "Kit desinstalado. Abrí una terminal nueva."
azul "═══════════════════════════════════════════"
echo
